# 嵌入：hash 可直接运行；local 需要安装 requirements-optional.txt
RAG_EMBEDDING_BACKEND=hash
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3

# LLM：留空时使用模板答案，配置后自动生成自然语言回答
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=https://api.deepseek.com/v1
RAG_LLM_MODEL=deepseek-chat
RAG_LLM_TIMEOUT_SECONDS=30
RAG_LLM_DIRECT_FALLBACK=true

# Web 服务：0.0.0.0 允许同一局域网访问
RAG_UI_HOST=0.0.0.0
RAG_UI_PORT=8765

# 检索参数
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=3
RAG_BM25_WEIGHT=0.4
RAG_VECTOR_WEIGHT=0.6

# 精排：本地模型模式可设为 true
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RETRIEVE_TOP_N=20

# 可选模型缓存与国内镜像
# HF_HOME=
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=1

# 成本估算（元/千 token）
RAG_INPUT_COST_PER_1K=0.002
RAG_OUTPUT_COST_PER_1K=0.008

# 目录：留空时优先 docs_input，否则 sample_docs
RAG_DOCS_DIR=
RAG_INDEX_PATH=
